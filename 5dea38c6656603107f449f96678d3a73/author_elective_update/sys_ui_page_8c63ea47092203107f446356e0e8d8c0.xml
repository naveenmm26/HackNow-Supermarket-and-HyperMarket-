        .ai-floating-btn:hover { transform: scale(1.08); }
        .ai-drawer { position: fixed; bottom: 96px; right: 24px; width: 420px; height: 580px; background: #ffffff; border-radius: 16px; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.25); border: 1px solid var(--border-color); display: none; flex-direction: column; overflow: hidden; z-index: 9999; }
