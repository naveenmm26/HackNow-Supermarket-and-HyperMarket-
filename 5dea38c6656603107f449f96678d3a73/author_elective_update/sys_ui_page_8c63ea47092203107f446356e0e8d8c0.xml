        .chart-body-donut { display: flex; align-items: center; gap: 14px; }
        .chart-container { width: 140px; height: 140px; position: relative; flex-shrink: 0; }
        .chart-container-full { width: 100%; height: 180px; position: relative; }
        /* Tables */
        .table-body { overflow-x: auto; max-height: 190px; }
        .report-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; text-align: left; }
