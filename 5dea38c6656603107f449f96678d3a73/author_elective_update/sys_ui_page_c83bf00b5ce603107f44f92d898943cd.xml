        <client_script><![CDATA[document.addEventListener("DOMContentLoaded", function() {
    const donutOpt = { responsive: true, maintainAspectRatio: false, cutout: "70%", plugins: { legend: { display: false } } };

    new Chart(document.getElementById("c1"), { type: "doughnut", data: { labels: ["Completed","Failed","Pending","Submitted"], datasets: [{ data: [184,32,26,12], backgroundColor: ["#22c55e","#ef4444","#f59e0b","#3b82f6"] }] }, options: donutOpt });
    new Chart(document.getElementById("c2"), { type: "bar", data: { labels: ["Store 1","Store 2","Store 3","Store 4","Store 5"], datasets: [{ label: "Issues", data: [12,8,6,4,2], backgroundColor: ["#ef4444","#f97316","#f59e0b","#22c55e","#3b82f6"] }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } } });
    new Chart(document.getElementById("c3"), { type: "doughnut", data: { labels: ["Critical","High","Medium","Low"], datasets: [{ data: [5,10,12,18], backgroundColor: ["#ef4444","#f97316","#f59e0b","#22c55e"] }] }, options: donutOpt });
    new Chart(document.getElementById("c5"), { type: "doughnut", data: { labels: ["Open","In Progress","Completed"], datasets: [{ data: [18,15,8], backgroundColor: ["#ef4444","#f97316","#22c55e"] }] }, options: donutOpt });

    function loadLiveKpiMetrics() {
        try {
            var grStore = new GlideRecord("x_fresh_guard_360_store");
            grStore.query(function(gr) {
                var c = 0; while (gr.next()) c++;
                if (c > 0 && document.getElementById("kpiTotalStores")) document.getElementById("kpiTotalStores").textContent = c;
            });
        } catch(e) {}
        try {
            var grCheck = new GlideRecord("x_fresh_guard_360_checklist");
            grCheck.query(function(gr) {
                var c = 0; while (gr.next()) c++;
                if (c > 0 && document.getElementById("kpiChecklists")) document.getElementById("kpiChecklists").textContent = c;
            });
        } catch(e) {}
        try {
            var grIss = new GlideRecord("x_fresh_guard_360_issue");
            grIss.query(function(gr) {
                var c = 0; while (gr.next()) c++;
                if (c > 0 && document.getElementById("kpiIssues")) document.getElementById("kpiIssues").textContent = c;
            });
        } catch(e) {}
        try {
            var grRisk = new GlideRecord("x_fresh_guard_360_issue");
            grRisk.query(function(gr) {
                var c = 0;
                while (gr.next()) {
                    var r = (gr.getValue("u_risk_level") || "").toLowerCase();
                    if (r.includes("high") || r.includes("critical")) c++;
                }
                if (c > 0 && document.getElementById("kpiRisks")) document.getElementById("kpiRisks").textContent = c;
            });
        } catch(e) {}
        try {
            var grCapa = new GlideRecord("x_fresh_guard_360_capa");
            grCapa.query(function(gr) {
                var c = 0; while (gr.next()) c++;
                if (c > 0 && document.getElementById("kpiCapa")) document.getElementById("kpiCapa").textContent = c;
            });
        } catch(e) {}
        try {
            var grMaint = new GlideRecord("x_fresh_guard_360_inspection");
            grMaint.query(function(gr) {
                var c = 0; while (gr.next()) c++;
                if (c > 0 && document.getElementById("kpiTickets")) document.getElementById("kpiTickets").textContent = c;
            });
        } catch(e) {}
    }
    loadLiveKpiMetrics();

    let currentUserName = "$[jvar_user_first_name]";
    if (!currentUserName || currentUserName === "User" || currentUserName === "$[jvar_user_first_name]") currentUserName = "Manoj";

    const aiBtn = document.getElementById("aiBtn");
    const aiDrawer = document.getElementById("aiDrawer");
    const aiClose = document.getElementById("aiClose");
    const aiSend = document.getElementById("aiSend");
    const aiInput = document.getElementById("aiInput");
    const aiChatBody = document.getElementById("aiChatBody");
    const chipsContainer = document.getElementById("suggestedChips");

    const defaultPrompts = [
        "Show me today's checklist status.",
        "Which stores have high-risk issues?",
        "Are any products nearing expiry?",
        "Show me recent food safety inspections.",
        "Are there any pending supplier complaints?"
    ];

    function renderChips() {
        chipsContainer.innerHTML = "";
        defaultPrompts.forEach(q => {
            const btn = document.createElement("button");
            btn.className = "chip-btn"; btn.textContent = q;
            btn.onclick = () => { aiInput.value = q; handleSend(); };
            chipsContainer.appendChild(btn);
        });
    }
    renderChips();

    if (aiBtn) aiBtn.onclick = () => aiDrawer.classList.toggle("active");
    if (aiClose) aiClose.onclick = () => aiDrawer.classList.remove("active");

    function appendMessage(sender, text) {
        const div = document.createElement("div");
        div.className = "chat-msg " + (sender === "user" ? "msg-user" : "msg-ai");
        div.innerHTML = text.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>").replace(/\n/g, "<br/>");
        aiChatBody.appendChild(div);
        aiChatBody.scrollTop = aiChatBody.scrollHeight;
    }

    function handleSend() {
        const q = aiInput.value.trim(); if (!q) return;
        appendMessage("user", q); aiInput.value = "";
        const qLower = q.toLowerCase();

        const greetingRegex = /^(hi|hii|hiii|helo|hello|helloo|hey|heyy|heyyy|greetings|daii|hola|good\s*morning|good\s*afternoon|good\s*evening)$/i;
        if (greetingRegex.test(qLower) || (qLower.startsWith("hi") && qLower.length <= 5) || (qLower.startsWith("hel") && qLower.length <= 6)) {
            setTimeout(() => appendMessage("ai", "Hi " + currentUserName + "! ]]>👋<![CDATA[ How can I help you today? You can ask me anything about food safety, store checklists, products, inspections, or supplier complaints."), 300);
            return;
        }

        setTimeout(() => {
            if (qLower.includes("checklist")) {
                appendMessage("ai", "]]>📋<![CDATA[ **TODAY'S CHECKLIST STATUS (" + currentUserName + ")**\n\n• **Total Submitted:** 184 Checklists\n• **Passed Checklists:** 152 (82.6% Compliance Rate)\n• **Failed Checklists:** 32 (17.4% Fail Rate)\n\n]]>🚨<![CDATA[ *Stores Needing Attention: Store 1 (NYC), Store 3 (Queens).*");
            } else if (qLower.includes("risk") || qLower.includes("high-risk") || qLower.includes("issue")) {
                appendMessage("ai", "]]>🛡<![CDATA[️ **HIGH-RISK STORES & ISSUES ANALYSIS**\n\n• **Store 1 (NYC Downtown):** **CRITICAL RISK** (12 Open Issues)\n• **Store 2 (Brooklyn North):** **HIGH RISK** (8 Open Issues)\n• **Store 3 (Queens Central):** **MEDIUM RISK** (6 Open Issues)");
            } else if (qLower.includes("expiry") || qLower.includes("product") || qLower.includes("batch")) {
                appendMessage("ai", "⚠️ **PRODUCTS NEARING EXPIRY & EXPIRED BATCHES**\n\n• **Milk 1L** (BATCH-1001) - Expiry: 24 May 2025 - **Near Expiry**\n• **Cheese 200g** (BATCH-1002) - Expiry: 25 May 2025 - **Near Expiry**\n• **Chicken Breast** (BATCH-1004) - Expiry: 23 May 2025 - **EXPIRED**");
            } else if (qLower.includes("inspection") || qLower.includes("audit") || qLower.includes("inspect")) {
                appendMessage("ai", "]]>🔍<![CDATA[ **RECENT FOOD SAFETY INSPECTIONS**\n\n• **Store 1 (NYC Downtown):** Inspected 22 May 2025 - **Grade B (Pass with CAPA)**\n• **Store 2 (Brooklyn North):** Inspected 20 May 2025 - **Grade A (Compliant)**\n• **Store 3 (Queens Central):** Scheduled for 26 May 2025");
            } else if (qLower.includes("supplier") || qLower.includes("complaint") || qLower.includes("vendor")) {
                appendMessage("ai", "]]>🏭<![CDATA[ **PENDING SUPPLIER COMPLAINTS & QUALITY ISSUES**\n\n• **Dairy Best:** 5 Active Complaints (Packaging Seal Defects)\n• **Meat Prime Inc:** 3 Active Complaints (Temperature Violation during Transit)\n• **Fresh Farm Produce:** 1 Active Complaint (Label Mismatch)");
            } else {
                appendMessage("ai", "I'm not sure I completely understood that. Could you please rephrase your question? ]]>😊<![CDATA[\n\nYou can ask me about store checklists, risk issues, near-expiry products, inspections, or supplier complaints.");
            }
        }, 400);
    }

    if (aiSend) aiSend.onclick = handleSend;
    if (aiInput) aiInput.onkeypress = (e) => { if (e.key === "Enter") handleSend(); };
});
]]></client_script>
