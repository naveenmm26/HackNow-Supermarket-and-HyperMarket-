        <script><![CDATA[(function executeFlow2(current, previous) {
    if (current.u_expiry_date) {
        var gdtExpiry = new GlideDateTime(current.u_expiry_date + ' 00:00:00');
        var gdtNow = new GlideDateTime();
        var daysRem = Math.floor((gdtExpiry.getNumericValue() - gdtNow.getNumericValue()) / 86400000);
        current.u_expiry_days_rem = daysRem;
        if (daysRem <= 0) {
            current.u_safety_status = 'expired';
            gs.info('[FLOW 2] Product ' + current.u_product_name + ' marked EXPIRED');
        } else if (daysRem <= 2) {
            current.u_safety_status = 'near_expiry';
            gs.info('[FLOW 2] Product ' + current.u_product_name + ' marked NEAR EXPIRY');
        }
    }
})(current, previous);]]></script>
