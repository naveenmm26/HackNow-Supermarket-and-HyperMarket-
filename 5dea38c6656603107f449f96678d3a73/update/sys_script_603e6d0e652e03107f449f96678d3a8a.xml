        <script><![CDATA[(function executeFlow5(current, previous) {
    if (current.u_status == 'completed') {
        if (current.u_verification_status == 'fully_verified' || current.u_verification_status == 'pass') {
            current.u_status = 'closed';
            var grIss = new GlideRecord('x_fresh_guard_360_issue');
            if (grIss.get(current.u_issue)) {
                grIss.setValue('u_status', 'closed');
                grIss.update();
            }
            gs.info('[FLOW 5] CAPA & Linked Issue Verified and Closed!');
        } else {
            current.u_status = 'pending_verification';
            gs.info('[FLOW 5] CAPA set to Pending Verification for Officer Sign-off');
        }
    }
})(current, previous);]]></script>
