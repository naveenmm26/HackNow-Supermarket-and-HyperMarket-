        <script><![CDATA[(function executeRule(current, previous) {
    var checkFields = ['u_temp_check', 'u_cleaning_check', 'u_hygiene_check', 'u_pest_check', 'u_expiry_check', 'u_storage_check', 'u_equip_check'];
    var passCount = 0;
    var failCount = 0;
    for (var i = 0; i < checkFields.length; i++) {
        var val = current.getValue(checkFields[i]);
        if (val == 'pass') passCount++;
        else if (val == 'fail') failCount++;
    }
    var score = ((passCount / checkFields.length) * 100).toFixed(2);
    current.u_overall_score = score;
    if (failCount >= 3 || score < 50) {
        current.u_risk_level = 'critical';
        current.u_status = 'failed';
    } else if (failCount >= 1 || score < 80) {
        current.u_risk_level = 'high';
    } else {
        current.u_risk_level = 'low';
    }
})(current, previous);]]></script>
